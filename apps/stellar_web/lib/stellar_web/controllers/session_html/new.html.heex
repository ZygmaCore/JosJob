<div class="min-h-screen flex items-center justify-center bg-base-200 p-4">
  <div class="card w-full max-w-sm bg-base-100 shadow-xl">
    <div class="card-body items-center text-center gap-4">
      <h1 class="text-2xl font-bold">Stellar CMS</h1>
      <p class="text-sm opacity-70">Masuk untuk melanjutkan ke dashboard admin.</p>

      <div
        :if={msg = Phoenix.Flash.get(@flash, :error)}
        class="alert alert-error text-sm w-full"
        role="alert"
      >
        {msg}
      </div>

      <div
        :if={msg = Phoenix.Flash.get(@flash, :info)}
        class="alert alert-info text-sm w-full"
        role="alert"
      >
        {msg}
      </div>

      <a href="/auth/user/google" class="btn btn-neutral w-full mt-2">
        <svg class="w-5 h-5" viewBox="0 0 48 48" aria-hidden="true">
          <path
            fill="#FFC107"
            d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.3 4.5 29.4 2.5 24 2.5 12.1 2.5 2.5 12.1 2.5 24S12.1 45.5 24 45.5 45.5 35.9 45.5 24c0-1.2-.1-2.3-.3-3.5z"
          />
          <path
            fill="#FF3D00"
            d="M4.3 13.7l6.6 4.8C12.7 14.5 17.9 11.5 24 11.5c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.3 4.5 29.4 2.5 24 2.5 15.9 2.5 8.8 7.1 4.3 13.7z"
          />
          <path
            fill="#4CAF50"
            d="M24 45.5c5.3 0 10.1-2 13.7-5.3l-6.3-5.3c-2 1.5-4.6 2.4-7.4 2.4-5.2 0-9.6-3.3-11.2-8l-6.5 5C8.7 40.8 15.8 45.5 24 45.5z"
          />
          <path
            fill="#1976D2"
            d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.2 4.2-4.1 5.6l6.3 5.3C41.2 36.6 45.5 31 45.5 24c0-1.2-.1-2.3-.3-3.5z"
          />
        </svg>
        Sign in with Google
      </a>
    </div>
  </div>
</div>
