# RAGPDF service — copy to .env and fill in. .env is gitignored.

# HTTP
RAGPDF_PORT=4010
# Optional shared secret between the main app and this service.
RAGPDF_API_TOKEN=
RAGPDF_START_SERVER=true

# Queue / limits
RAGPDF_MAX_CONCURRENCY=1
RAGPDF_MAX_ACTIVE_PER_USER=1
RAGPDF_MAX_QUEUE_SIZE=50
RAGPDF_MAX_PDF_BYTES=10000000
RAGPDF_MAX_PAGES_PER_REQUEST=6
RAGPDF_CHUNK_OVERLAP_PAGES=1
RAGPDF_JOB_TTL_SECONDS=3600
RAGPDF_CLEANUP_INTERVAL_MS=60000
RAGPDF_HTTP_TIMEOUT_MS=120000
RAGPDF_RETRY_MAX_ATTEMPTS=3
RAGPDF_RETRY_BASE_DELAY_MS=1000

# PDF tools (NixOS: nix-shell -p qpdf poppler-utils)
RAGPDF_QPDF_BIN=qpdf
RAGPDF_PDFTOTEXT_BIN=pdftotext

# Gemini primary
# Key lookup: GEMINI_API_KEY first, then GOOGLE_API_KEY. Leave both unset here
# when the repo-level envs/.env already provides one — a blank value would
# shadow it.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Deliberately service-prefixed: the repo-level envs/.env pins GEMINI_MODEL to
# an embedding model, so the shared name must not be read here.
RAGPDF_GEMINI_MODEL=gemini-3.5-flash
RAGPDF_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 9Router fallback (blind set; not tested yet)
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=gpt-4o-mini

# Comma-separated. Allowed: gemini, nine_router, keyword
RAGPDF_PROVIDER_ORDER=gemini,nine_router,keyword
